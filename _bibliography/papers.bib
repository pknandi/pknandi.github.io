@inproceedings{azad2026bafco,
  abbr        = {ECCV},
  bibtex_show = {true},
  title       = {BaFCo: A Document Understanding Benchmark for Complex Bangla Form Comprehension},
  author      = {Azad, Abu Tyeb and Apan, Ishita Sur and Ahmed, Fahim and Katha, Sumaiya Karim and Jubaer, Ezharuddin and Alam, Armun and Nandi, Pranjal Kumar and Ali, Amin Ahsan and Chadha, Aman and Islam, Md Mofijul and Rahman, AKM Mahbubur},
  booktitle   = {European Conference on Computer Vision (ECCV)},
  location    = {Malmö, Sweden},
  year        = {2026},
  abstract    = {BaFCo is a benchmark of 200 multi-page Bangladeshi government forms spanning sectors such as agriculture, education, banking, and land management, annotated with 26 fine-grained entity types for Document Layout Analysis and Key Information Extraction. We evaluate frontier and open multimodal LLMs under zero-shot and chain-of-thought prompting and find that current models struggle to comprehend Bangla forms, especially when localizing fine-grained entities.},
  arxiv       = {2607.05614},
  html        = {https://arxiv.org/abs/2607.05614},
  pdf         = {https://arxiv.org/pdf/2607.05614},
  selected    = {true}
}

