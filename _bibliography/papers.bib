@inproceedings{azad2026bafco,
  abbr        = {ECCV},
  bibtex_show = {true},
  title       = {BaFCo: A Document Understanding Benchmark for Complex Bangla Form Comprehension},
  author      = {Azad, Abu Tyeb and Apan, Ishita Sur and Ahmed, Fahim and Katha, Sumaiya Karim and Jubaer, Ezharuddin and Alam, Armun and Nandi, Pranjal Kumar and Ali, Amin Ahsan and Chadha, Aman and Islam, Md Mofijul and Rahman, AKM Mahbubur},
  booktitle   = {European Conference on Computer Vision (ECCV)},
  location    = {Malmö, Sweden},
  year        = {2026},
  abstract    = {BaFCo is a benchmark of 200 multi-page Bangladeshi government forms spanning sectors such as agriculture, education, banking, and land management, annotated with 26 fine-grained entity types for Document Layout Analysis and Key Information Extraction. We evaluate frontier and open multimodal LLMs under zero-shot and chain-of-thought prompting and find that current models struggle to comprehend Bangla forms, especially when localizing fine-grained entities.},
  arxiv       = {2607.05614},
  html        = {https://arxiv.org/abs/2607.05614},
  pdf         = {https://arxiv.org/pdf/2607.05614},
  poster      = {https://eccv.ecva.net/virtual/2026/poster/5793},
  preview     = {bafco_data_diversity.png},
  selected    = {true}
}

@misc{kelly2026remotecare,
  abbr         = {Patent App.},
  bibtex_show  = {true},
  title        = {Using Artificial Intelligence/Machine Learning for Remote Monitoring and Assisting of Individuals Under Care, and Systems and Methods Therefor},
  author       = {Kelly, James Michael and Turock, David Lawrence and Brockie, Justin Mark and Ali, Md Asif and Hossain, Meheraj and Hassan, Raheeb and Islam, Md Nazrul and Mahmud, Rafid Ameer and Nandi, Pranjal Kumar and Robbins, Richard Allen and Sepesi, William Edward and Wahed, Md Rayed Bin and Brockman, James Joseph},
  howpublished = {US Patent Application Publication US20260229324A1},
  note         = {US Patent Application Publication US20260229324A1 (pending). Assignee: Therap Services LLC.},
  year         = {2026},
  month        = {aug},
  abstract     = {A HIPAA-compliant system for remotely monitoring and assisting individuals under care. Sensor data from the individual's location is converted into textual descriptions, combined into a unified description, and matched against a database of known events; the matching event's action plan, such as alerting a caregiver whose caseload permits access to the individual's information, is then carried out. Unmatched events can be labeled with a new action, which is stored for future use.},
  html         = {https://patents.google.com/patent/US20260229324A1/en},
  selected     = {true}
}

